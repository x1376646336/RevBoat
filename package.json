{
  "name": "revboat",
  "version": "0.6.6",
  "description": "版舟 RevBoat · SVN 桌面客户端",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "check": "npm run build && npm run test:unit && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo test --manifest-path src-tauri/Cargo.toml",
    "icons": "node src-tauri/icons/generate-icons.js",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.cjs",
    "release": "node scripts/tauri.cjs build",
    "test:unit": "node --test tests/*.test.cjs",
    "prepare:svn": "node scripts/prepare-svn.cjs",
    "precheck": "npm run prepare:svn",
    "build:with-svn": "node scripts/build-with-svn.cjs",
    "test:auth-ui": "node scripts/check-authentication-ui.cjs",
    "test:desktop-ui": "node scripts/check-desktop-ui.cjs",
    "test:diff-account-ui": "node scripts/check-diff-account-ui.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "element-plus": "^2.6.0",
    "material-symbols": "^0.45.8",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-i18n": "^11.3.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.0.4",
    "playwright": "1.62.1",
    "typescript": "^5.4.0",
    "vite": "^5.1.6",
    "vue-tsc": "^2.0.0"
  },
  "upstreamUpdatesEnabled": false
}
